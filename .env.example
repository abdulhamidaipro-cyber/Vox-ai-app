# ============================================
# Template — copy to .env.local and fill values
# .env.local is gitignored. NEVER commit secrets.
# ============================================

# --- n8n instance ---
# Base URL of your n8n cloud/self-hosted instance
N8N_API_URL=https://your-n8n-instance.com/

# n8n public API key (Settings → API in n8n UI)
# Used by tooling (n8n-mcp) to manage workflows
N8N_API_KEY=

# --- n8n webhooks (one per workflow) ---
# Add the production webhook URL for each workflow you wire up.
# Naming convention: N8N_WEBHOOK_<WORKFLOW_NAME>

# Workflow: Instagram Reels + Voice Transcription (see n8n/reels-voice-app.md)
N8N_WEBHOOK_INSTAGRAM_REEL=https://your-n8n-instance.com/webhook/instagram-reel
N8N_WEBHOOK_TRANSCRIBE_VOICE=https://your-n8n-instance.com/webhook/transcribe-voice

# Optional shared auth token if you protect webhooks with a header
N8N_AUTH_TOKEN=

# --- GitHub ---
# Personal Access Token (fine-grained recommended) for repo push/deploy
GITHUB_PAT=
